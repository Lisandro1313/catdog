generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Una cena. Solo se muestra en el home la próxima publicada.
model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  menu        String?
  date        DateTime
  /// Precio por persona en pesos argentinos (entero, sin centavos).
  price       Int
  capacity    Int      @default(15)
  /// Carta de barra: un trago por línea, "nombre | descripción".
  bar         String?
  /// Precio de cada trago de barra, en pesos.
  barPrice    Int?
  /// Dirección exacta: solo se muestra a quien ya pagó.
  address     String?
  published   Boolean  @default(true)
  /// Cuándo se les avisó a los suscriptores (null = todavía no).
  notifiedAt  DateTime?
  /// Cuándo se mandó el pedido de opiniones (manual o automático), para no repetirlo.
  reviewsRequestedAt DateTime?
  createdAt   DateTime @default(now())

  reservations Reservation[]
  seats        Seat[]
  ledger       LedgerEntry[]
  reviews      Review[]
}

enum ReservationStatus {
  PENDING
  PAID
  CANCELLED
}

model Reservation {
  id             String            @id @default(cuid())
  eventId        String
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String
  email          String
  phone          String?
  /// Cantidad de lugares reservados. Las sillas concretas se eligen después de pagar.
  quantity       Int               @default(1)
  status         ReservationStatus @default(PENDING)
  /// Total en pesos (precio x cantidad de lugares).
  amount         Int
  mpPreferenceId String?
  mpInitPoint    String?
  mpPaymentId    String?           @unique
  /// "mercadopago" | "efectivo" | "transferencia"
  paidVia        String?
  paidAt         DateTime?
  seatsChosenAt  DateTime?
  /// Lo que el invitado quiere que sepamos (alergias, vegetariano, celebración).
  notes          String?
  /// Recordatorio del día anterior y confirmación de asistencia desde ese mail.
  remindedAt     DateTime?
  confirmedAt    DateTime?
  /// Marcado en la puerta, la noche de la cena.
  arrivedAt      DateTime?
  /// Hasta cuándo se mantienen los lugares si el pago sigue pendiente.
  expiresAt      DateTime
  createdAt      DateTime          @default(now())

  seats  Seat[]
  review Review?

  @@index([eventId, status])
}

/// Un lugar en la mesa tomado por una reserva. Único por evento.
model Seat {
  id            String      @id @default(cuid())
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  number        Int
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([eventId, number])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Visitas al sitio, agregadas por día y ruta (sin datos personales).
model PageView {
  id    String   @id @default(cuid())
  day   DateTime @db.Date
  path  String
  count Int      @default(0)

  @@unique([day, path])
}

enum LedgerKind {
  INCOME
  EXPENSE
  /// Un socio pone plata en el negocio (capital, o para cubrir algo).
  CONTRIBUTION
  /// Un socio se lleva plata del negocio.
  WITHDRAWAL
}

/// Movimientos de caja: gastos del día a día y ventas de barra.
/// Si tienen `eventId` pertenecen a una cena; si no, son gastos generales (alquiler, luz, verdulería...).
model LedgerEntry {
  id          String     @id @default(cuid())
  eventId     String?
  event       Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind        LedgerKind
  /// Rubro: ver src/lib/ledger-categories.ts
  category    String
  description String?
  /// Monto en pesos (entero).
  amount      Int
  /// Día del movimiento (fecha argentina). Se usa para agrupar por semana.
  day         DateTime   @default(dbgenerated("CURRENT_DATE")) @db.Date
  /// Quién lo cargó / lo pagó / lo aportó / lo retiró.
  by          String?
  /// Solo para gastos: true = lo pagó el socio de su bolsillo (el negocio se lo debe); false = salió de la caja.
  fromPocket  Boolean    @default(true)
  /// Foto del ticket / factura, guardada en Vercel Blob (privada).
  receiptUrl  String?
  /// Auditoría: quién lo cargó, quién lo editó por última vez, quién lo borró.
  createdBy   String?
  updatedAt   DateTime?
  updatedBy   String?
  /// Borrado suave: los movimientos borrados no cuentan pero se pueden restaurar desde la papelera.
  deletedAt   DateTime?
  deletedBy   String?
  /// Si lo generó un gasto fijo: cuál y para qué semana (lunes, "YYYY-MM-DD"). Evita duplicados.
  fixedExpenseId String?
  fixedExpense   FixedExpense? @relation(fields: [fixedExpenseId], references: [id], onDelete: SetNull)
  periodKey      String?
  createdAt   DateTime   @default(now())

  @@unique([fixedExpenseId, periodKey])
  @@index([eventId])
  @@index([day])
  @@index([deletedAt])
}

/// Gastos fijos mensuales (alquiler, luz, gas, internet…). Cada semana se genera
/// automáticamente un gasto por el prorrateo semanal (mensual × 12 ÷ 52).
model FixedExpense {
  id            String   @id @default(cuid())
  name          String
  category      String
  monthlyAmount Int
  active        Boolean  @default(true)
  /// Desde qué día corre (se generan las semanas desde la de esta fecha).
  startsOn      DateTime @db.Date
  createdAt     DateTime @default(now())

  entries LedgerEntry[]
}

/// Usuarios del panel: un socio, una contraseña. La contraseña maestra (ADMIN_PASSWORD) siempre entra.
model User {
  id           String   @id @default(cuid())
  name         String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Configuración editable desde el panel (por ejemplo la reserva para gastos fijos).
model Setting {
  key   String @id
  value String
}

/// Fotos del lugar para el home. Se suben desde Ajustes (Vercel Blob, públicas).
model Photo {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())
}

/// Opinión de alguien que vino. Aparece en el home solo cuando se aprueba desde el panel.
model Review {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  rating        Int
  text          String
  approved      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([approved, createdAt])
}
