generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Una cena. Solo se muestra en el home la próxima publicada.
model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  menu        String?
  date        DateTime
  /// Precio por persona en pesos argentinos (entero, sin centavos).
  price       Int
  capacity    Int      @default(15)
  /// Carta de barra: un trago por línea, "nombre | descripción".
  bar         String?
  /// Precio de cada trago de barra, en pesos.
  barPrice    Int?
  /// Dirección exacta: solo se muestra a quien ya pagó.
  address     String?
  published   Boolean  @default(true)
  /// Cuándo se les avisó a los suscriptores (null = todavía no).
  notifiedAt  DateTime?
  /// Cuándo se mandó el pedido de opiniones (manual o automático), para no repetirlo.
  reviewsRequestedAt DateTime?
  /// Reservas cerradas a mano (p. ej. el día de la cena, para cerrar la lista): el público ve "reservas cerradas".
  closedAt    DateTime?
  /// Cena privada / a pedido: no aparece en el home ni en /fechas; se reserva solo con su link (/privada/[id]).
  unlisted    Boolean  @default(false)
  /// Cuándo se mandó el mail "falta esto para el viernes" (una vez por cena).
  missingNotifiedAt DateTime?
  createdAt   DateTime @default(now())

  /// Cóctel de recepción (sin alcohol): "nombre | una frase". Es el Acto I del juego de las mesitas.
  welcomeDrink String?

  /// Carta en vivo: índice del último acto que salió a la mesa (null = todavía nada). Lo marca la cocina desde el panel.
  servedStep Int?
  servedAt   DateTime?
  /// Receta de regalo (texto libre): se manda por mail al día siguiente a los que vinieron.
  recipeGift   String?
  recipeSentAt DateTime?

  reservations Reservation[]
  seats        Seat[]
  ledger       LedgerEntry[]
  reviews      Review[]
  steps        EventStep[]
  guesses      Guess[]
  waitlist Waitlist[]
  barSales BarSale[]
  huellas  Huella[]
  votos    Voto[]
  pedidos  Pedido[]
  sugerencias Sugerencia[]
}

/// "Lo que no dice la carta": un secreto por acto del juego de las mesitas. index 0 = recepción, 1..n = pasos del menú.
model EventStep {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  index   Int
  /// El ingrediente que hay que adivinar.
  secret  String?
  /// Tres señuelos separados por coma.
  decoys  String?
  /// Por qué ese cóctel con ese plato (una o dos líneas).
  why     String?

  @@unique([eventId, index])
}

/// Una apuesta por teléfono y por acto. deviceKey es un id al azar guardado en el teléfono: sin datos personales.
model Guess {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stepIndex Int
  deviceKey String
  choice    String
  stake     Int      @default(1)
  correct   Boolean
  table     Int?
  createdAt DateTime @default(now())

  @@unique([eventId, stepIndex, deviceKey])
  @@index([eventId, stepIndex])
}

enum ReservationStatus {
  PENDING
  PAID
  CANCELLED
}

model Reservation {
  id             String            @id @default(cuid())
  eventId        String
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String
  email          String
  phone          String?
  /// Cantidad de lugares reservados. Las sillas concretas se eligen después de pagar.
  quantity       Int               @default(1)
  status         ReservationStatus @default(PENDING)
  /// Total en pesos (precio x cantidad de lugares).
  amount         Int
  mpPreferenceId String?
  mpInitPoint    String?
  mpPaymentId    String?           @unique
  /// "mercadopago" | "efectivo" | "transferencia"
  paidVia        String?
  paidAt         DateTime?
  seatsChosenAt  DateTime?
  /// Lo que el invitado quiere que sepamos (alergias, vegetariano, celebración).
  notes          String?
  /// Recordatorio del día anterior y confirmación de asistencia desde ese mail.
  remindedAt     DateTime?
  confirmedAt    DateTime?
  /// Marcado en la puerta, la noche de la cena.
  arrivedAt      DateTime?
  /// Avisó desde el recordatorio que no viene (la reserva pasa a CANCELLED y se libera el lugar).
  declinedAt     DateTime?
  /// Es un regalo: para quién, su mail (opcional, para mandarle la tarjeta) y un mensaje.
  giftName       String?
  giftEmail      String?
  giftMessage    String?
  /// Huella (hash) de la IP que creó el hold, para limitar reservas en proceso por persona.
  ipHash         String?
  /// Hasta cuándo se mantienen los lugares si el pago sigue pendiente.
  expiresAt      DateTime
  createdAt      DateTime          @default(now())

  seats  Seat[]
  review Review?

  @@index([eventId, status])
}

/// Un lugar en la mesa tomado por una reserva. Único por evento.
model Seat {
  id            String      @id @default(cuid())
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  number        Int
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([eventId, number])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Visitas al sitio, agregadas por día y ruta (sin datos personales).
model PageView {
  id    String   @id @default(cuid())
  day   DateTime @db.Date
  path  String
  count Int      @default(0)

  @@unique([day, path])
}

enum LedgerKind {
  INCOME
  EXPENSE
  /// Un socio pone plata en el negocio (capital, o para cubrir algo).
  CONTRIBUTION
  /// Un socio se lleva plata del negocio.
  WITHDRAWAL
}

/// Movimientos de caja: gastos del día a día y ventas de barra.
/// Si tienen `eventId` pertenecen a una cena; si no, son gastos generales (alquiler, luz, verdulería...).
model LedgerEntry {
  id          String     @id @default(cuid())
  eventId     String?
  event       Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind        LedgerKind
  /// Rubro: ver src/lib/ledger-categories.ts
  category    String
  description String?
  /// Monto en pesos (entero).
  amount      Int
  /// Día del movimiento (fecha argentina). Se usa para agrupar por semana.
  day         DateTime   @default(dbgenerated("CURRENT_DATE")) @db.Date
  /// Quién lo cargó / lo pagó / lo aportó / lo retiró.
  by          String?
  /// Solo para gastos: true = lo pagó el socio de su bolsillo (el negocio se lo debe); false = salió de la caja.
  fromPocket  Boolean    @default(true)
  /// Foto del ticket / factura, guardada en Vercel Blob (privada).
  receiptUrl  String?
  /// Auditoría: quién lo cargó, quién lo editó por última vez, quién lo borró.
  createdBy   String?
  updatedAt   DateTime?
  updatedBy   String?
  /// Borrado suave: los movimientos borrados no cuentan pero se pueden restaurar desde la papelera.
  deletedAt   DateTime?
  deletedBy   String?
  /// Si lo generó un gasto fijo: cuál y para qué semana (lunes, "YYYY-MM-DD"). Evita duplicados.
  fixedExpenseId String?
  fixedExpense   FixedExpense? @relation(fields: [fixedExpenseId], references: [id], onDelete: SetNull)
  periodKey      String?
  createdAt   DateTime   @default(now())

  @@unique([fixedExpenseId, periodKey])
  @@index([eventId])
  @@index([day])
  @@index([deletedAt])
}

/// Gastos fijos mensuales (alquiler, luz, gas, internet…). Cada semana se genera
/// automáticamente un gasto por el prorrateo semanal (mensual × 12 ÷ 52).
model FixedExpense {
  id            String   @id @default(cuid())
  name          String
  category      String
  monthlyAmount Int
  active        Boolean  @default(true)
  /// Desde qué día corre (se generan las semanas desde la de esta fecha).
  startsOn      DateTime @db.Date
  createdAt     DateTime @default(now())

  entries LedgerEntry[]
}

/// Usuarios del panel: un socio, una contraseña. La contraseña maestra (ADMIN_PASSWORD) siempre entra.
model User {
  id           String   @id @default(cuid())
  name         String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Configuración editable desde el panel (por ejemplo la reserva para gastos fijos).
model Setting {
  key   String @id
  value String
}

/// Fotos del lugar para el home. Se suben desde Ajustes (Vercel Blob, públicas).
model Photo {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())
}

/// Opinión de alguien que vino. Aparece en el home solo cuando se aprueba desde el panel.
model Review {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  rating        Int
  text          String
  approved      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([approved, createdAt])
}

/// Mejor marca de un teléfono en cada juego de /hoy/jugar (memoria = movimientos, el resto = puntos).
model GameScore {
  id        String   @id @default(cuid())
  deviceKey String
  game      String
  best      Int
  /// Nombre para la tabla de récords (lo elige el jugador; opcional).
  name      String?
  /// Noche (día argentino "2026-09-25"): el premio se gana con las marcas de esa noche; los récords miran todas.
  day       String   @default("")
  updatedAt DateTime @updatedAt

  @@unique([deviceKey, game, day])
  @@index([game, best])
}

/// Un trago ganado: el código lo emite el servidor, uno por teléfono y por día, y se canjea desde el panel.
model Prize {
  id         String    @id @default(cuid())
  code       String    @unique
  deviceKey  String
  day        String
  createdAt  DateTime  @default(now())
  redeemedAt DateTime?
  redeemedBy String?

  @@unique([deviceKey, day])
}

/// Lista de espera de una fecha agotada: se avisa por mail cuando se libera un lugar (una vez por persona).
model Waitlist {
  id         String    @id @default(cuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email      String
  name       String?
  quantity   Int       @default(1)
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([eventId, email])
}

/// Consumo de barra por mesita durante la noche (se cuenta con +/- desde el celu; al cierre pasa a la caja).
model BarSale {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// 0 = sin mesita (barra suelta).
  table     Int
  item      String
  /// Precio unitario al momento de cargarlo, en pesos.
  price     Int
  qty       Int       @default(0)
  updatedAt DateTime  @updatedAt
  /// Cuándo se pasó a la caja (null = noche abierta).
  settledAt DateTime?

  @@unique([eventId, table, item])
}

/// Huella de un invitado esa noche: nombre, una frase y/o una foto. Sale en el home cuando se aprueba desde el panel.
model Huella {
  id         String    @id @default(cuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deviceKey  String
  table      Int?
  name       String
  text       String?
  /// URL del blob privado; se sirve por /huella/[id] solo si está aprobada.
  photoUrl   String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([eventId])
}

/// Voto de "plato y trago de la noche": uno por teléfono y por tipo.
model Voto {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deviceKey String
  /// "plato" | "trago"
  kind      String
  choice    String
  createdAt DateTime @default(now())

  @@unique([eventId, deviceKey, kind])
}

/// Pedido a la barra desde la mesita (el cobro sigue siendo con BarSale, a mano).
model Pedido {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deviceKey String
  table     Int
  item      String
  qty       Int       @default(1)
  /// "pendiente" | "listo" | "cancelado"
  status    String    @default("pendiente")
  createdAt DateTime  @default(now())
  doneAt    DateTime?

  @@index([eventId, status])
}

/// Lo que recomiendan los invitados: un tema para la música o una idea para la casa.
model Sugerencia {
  id        String    @id @default(cuid())
  eventId   String?
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  deviceKey String
  /// "tema" | "idea"
  kind      String
  text      String
  createdAt DateTime  @default(now())
  seenAt    DateTime?
}
